{% extends 'appbase.html.twig' %}

{% block title %}Mon Profil
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('assets/appcss/dashboard.css') }}">
	<style>
		.profile-container { 
			margin: 0 auto;
		}
		.logout-btn {
			background-color: #dc3545;
			border-color: #dc3545;
			color: white;
		}
		.logout-btn:hover {
			background-color: #bb2d3b;
			border-color: #b02a37;
			color: white;
		}
	</style>
{% endblock %}

{% block main %}
	<div class="content-header">
		<div class="container-fluid d-flex justify-content-between align-items-center">
			<h1 class="h3">Mon Profil</h1>
			<a href="{{ path('app_logout') }}" class="btn logout-btn">
				<i class="bi bi-box-arrow-right me-2"></i>Se déconnecter
			</a>
		</div>
	</div>

	<div class="content">
		<div class="container-fluid">
			<div class="card profile-container mb-4">
				<div class="row g-0">
					{# Colonne gauche : avatar + infos #}
					<div class="col-md-4 text-center p-4 border-end bg-light">
						{% if app.user is defined and app.user.avatarPath is defined and app.user.avatarPath %}
							<img src="{{ asset(app.user.avatarPath) }}" alt="Avatar" class="profile-avatar mb-3" style="width: 150px; height: 150px; object-fit: cover; border-radius: 50%;">
						{% else %}
							<i class="bi bi-person-circle display-1 text-info mb-3"></i>
						{% endif %}

						<h4 class="mb-1">{{ app.user.FullName }}</h4>

						<div class="rating mb-3">
							{% for i in 1..5 %}
								<i class="bi bi-star-fill text-warning"></i>
							{% endfor %}
							<span class="rating-value">4.8</span>
						</div>

						<ul class="list-unstyled profile-contacts">
							<li>
								<i class="bi bi-envelope-fill me-2"></i>
								{# {{ app.user.email }} #}
							</li>
							<li>
								<i class="bi bi-telephone-fill me-2"></i>
								{# {% if app.user.phone %}{{ app.user.phone }}{% else %}--{% endif %} #}
							</li>
						</ul>
					</div>

					{# Colonne droite : formulaire #}
					<div class="col-md-8 p-4">
						<h5 class="mb-4">Informations personnelles</h5>
						<form id="profileForm">
							<div class="row">
								<div class="col-md-6 mb-3">
									<label for="inpName" class="form-label">Nom complet</label>
									<input type="text" id="inpName" name="fullName" class="form-control" value="{{ app.user.fullName }}">
								</div>

								<div class="col-md-6 mb-3">
									<label for="inpJob" class="form-label">Poste</label>
									{# <input type="text" id="inpJob" name="jobTitle" class="form-control" value="{% if app.user.jobTitle %}{{ app.user.jobTitle }}{% endif %}"> #}
								</div>

								<div class="col-md-6 mb-3">
									<label for="inpEmail" class="form-label">Email</label>
									<input type="email" id="inpEmail" name="email" class="form-control" value="">
								</div>

								<div class="col-md-6 mb-3">
									<label for="inpPhone" class="form-label">Téléphone</label>
									{# <input type="text" id="inpPhone" name="phone" class="form-control" value="{% if app.user.phone %}{{ app.user.phone }}{% endif %}"> #}
								</div>

								<div class="col-12 mb-3">
									<label for="inpBio" class="form-label">Bio</label>
									{# <textarea id="inpBio" name="bio" class="form-control" rows="3">{% if app.user.bio %}{{ app.user.bio }}{% endif %}</textarea> #}
								</div>

								<div class="col-12 mt-3 d-flex gap-2">
									<button type="submit" class="btn btn-primary">
										Enregistrer les modifications
									</button>
									<button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#changePasswordModal">
										Changer mot de passe
									</button>
								</div>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>

	{# Modal Changer mot de passe #}
	<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<form id="changePasswordForm">
					<div class="modal-header">
						<h5 class="modal-title" id="changePasswordModalLabel">
							Changer mon mot de passe
						</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
					</div>
					<div class="modal-body">
						<div class="mb-3">
							<label for="oldPassword" class="form-label">Ancien mot de passe</label>
							<input type="password" class="form-control" id="oldPassword" name="oldPassword" required>
						</div>
						<div class="mb-3">
							<label for="newPassword" class="form-label">Nouveau mot de passe</label>
							<input type="password" class="form-control" id="newPassword" name="newPassword" minlength="8" required>
						</div>
						<div class="mb-3">
							<label for="confirmPassword" class="form-label">Confirmation</label>
							<input type="password" class="form-control" id="confirmPassword" name="confirmPassword" minlength="8" required>
						</div>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
							Annuler
						</button>
						<button type="submit" class="btn btn-success">
							Valider
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('assets/appjs/profil.js') }}"></script>
{% endblock %}
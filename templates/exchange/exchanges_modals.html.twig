<div class="modal fade" id="modalCancelExchange" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<form id="form-cancel-exchange">
				<div class="modal-header">
					<h5 class="modal-title">Annuler l'Échange</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<input type="hidden" id="cancelExchangeId" name="exchangeId">
					<div class="mb-3">
						<label class="form-label">Raison de l'annulation
							<span class="text-danger">*</span>
						</label>
						<textarea name="reason" class="form-control" rows="3"></textarea>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
					<button type="submit" class="btn btn-danger">Confirmer l'annulation</button>
				</div>
			</form>
		</div>
	</div>
</div>

{# Modal Suppression Échange #}
<div class="modal fade" id="modalDeleteExchange" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Supprimer l'Échange</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<p>Êtes-vous sûr de vouloir supprimer définitivement cet échange ?</p>
				<div class="alert alert-danger">
					<i class="bi bi-exclamation-triangle"></i>
					Cette action est irréversible et supprimera toutes les données associées.
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
				<button type="button" class="btn btn-danger" id="confirmDelete">Supprimer</button>
			</div>
		</div>
	</div>
</div>

{# Modal Voir Échange #}
<div class="modal fade" id="viewExchangeModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header bg-light">
				<h5 class="modal-title">Détails de l'Échange</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<div class="row">
					<div class="col-md-6">
						<div class="card mb-3">
							<div class="card-header bg-light">
								<h6 class="mb-0">
									<i class="bi bi-info-circle me-2"></i>Informations Générales</h6>
							</div>
							<div class="card-body">
								<div class="mb-2">
									<div class="d-flex justify-content-between">
										<small class="text-muted">Date :</small>
										<div class="fw-bold" id="exchangeDate"></div>
									</div>

									<div>
										<small class="text-muted">Type :</small>
										<div class="fw-bold" id="exchangeType"></div>
									</div>
								</div>

								<div class="mb-2">
									<small class="text-muted">Description :</small>
									<div id="exchangeDescription"></div>
								</div>
							</div>
						</div>
					</div>

					<div class="col-md-6">
						<div class="card h-100">
							<div class="card-header bg-light">
								<h6 class="mb-0">
									<i class="bi bi-cash-stack me-2"></i>Détails Financiers</h6>
							</div>
							<div class="card-body">
								<div class="mb-2">
									<small class="text-muted">Montant Devise :</small>
									<div class="fw-bold" id="exchangeDevise"></div>
								</div>

								<div class="mb-2">
									<small class="text-muted">Taux appliqué :</small>
									<div class="fw-bold" id="exchangeRate"></div>
								</div>
								<hr>
								<div class="mb-2">
									<small class="text-muted">Montant CFA :</small>
									<div class="fw-bold fs-5" id="exchangeAmount"></div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="modal-footer bg-light">
				<div class="d-flex justify-content-between w-100">
					<div>
						<button id="printReceiptBtn" class="btn btn-outline-secondary me-2">
							<i class="bi bi-printer me-1"></i>
							Imprimer
						</button>
					</div>
					<div>
						<button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">
							<i class="bi bi-x-circle me-1"></i>
							Fermer
						</button>
						<div class="btn-group">
							<button id="cancelExchangeBtn" class="btn btn-danger d-none">
								<i class="bi bi-x-circle me-1"></i>
								Annuler
							</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<div class="modal fade" id="modifyExchangeModalDirect" tabindex='-1' aria-hidden="true">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class='modal-header'>
				<h3>Modifier l'exchange direct</h3>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<div id="form-mod-direct-exchange" class="p-2">
					<!-- Section Client -->
					<div class="mb-3 border rounded p-2">
						<h5 class="text-primary mb-2">
							<i class="bi bi-person-fill me-1"></i>Agence</h5>
						<div class="row g-2">
							<div class="col-md-6">
								<label class="form-label small fw-bold">Depuis quel agence est faite l'échange ?
									<span class="text-danger">*</span>
								</label>
								<select id="agence-mod-direct" name="agence" class="form-select form-select-sm" required>
									{% for agence in agences %}
										<option value="{{ agence.id }}">{{ agence.designation }}</option>
									{% endfor %}
								</select>
							</div>
							<div class="col-md-6">
								<label class="form-label small fw-bold">Description (facultatif)</label>
								<textarea name="description" id="description-mod-direct" rows="1" class="form-control form-control-sm shadow-sm" placeholder="Notes ou précisions sur l’échange..."></textarea>
							</div>
							<div class="col-md-6"></div>
						</div>
					</div>

					<!-- Section Opération -->
					<div class="mb-3 border rounded p-2">
						<h5 class="text-primary mb-2">
							<i class="bi bi-gear-fill me-1"></i>Opération</h5>
						<div class="row g-2">
							<div class="col-md-4">
								<label class="form-label small fw-bold">Date
									<span class="text-danger">*</span>
								</label>
								<input type="date" id="dateOps-mod-direct" name="date" class="form-control form-control-sm" required>
							</div>
							<div class="col-md-4">
								<label class="form-label small fw-bold">Type
									<span class="text-danger">*</span>
								</label>
								<select id="typeOps-mod-direct" name="type" class="form-select form-select-sm" required>
									<option value="achat">Achat</option>
									<option value="vente">Vente</option>
								</select>
							</div>
							<div class="col-md-4">
								<label class="form-label small fw-bold">Devise
									<span class="text-danger">*</span>
								</label>
								<select id="deviseExchange-mod-direct" name="deviseExchange" class="form-select form-select-sm country-select" required>
									<option value="USD">USD - Dollar américain</option>
									<option value="AED">AED - Dirham des Émirats Arabes Unis</option>
									<option value="EUR">EUR - Euro</option>
									<option value="GBP">GBP - Livre sterling</option>
									<option value="CNY">CNY - Yuan chinois</option>
									<option value="MAD">MAD - Dirham marocain</option>
									<option value="DZD">DZD - Dinar algérien</option>
								</select>
							</div>
						</div>
					</div>

					<!-- Section Montants -->
					<div class="mb-3 border rounded p-2">
						<h5 class="text-primary mb-2">
							<i class="bi bi-cash-stack me-1"></i>Montants & Taux</h5>
						<div class="row g-2">
							<div class="col-md-4">
								<label class="form-label small fw-bold">Montant
									<span class="text-danger">*</span>
								</label>
								<div class="input-group input-group-sm">
									<span class="input-group-text">Montant :</span>
									<input type="number" id="montant-mod-direct" name="montant" class="form-control" placeholder="0.00" step="0.001" required>
									<span class="input-group-text" id="devise-mod-direct">-</span>
								</div>
							</div>
							<div class="col-md-5">
								<label class="form-label small fw-bold">Taux
									<span class="text-danger">*</span>
								</label>
								<div class="input-group input-group-sm">
									<span class="input-group-text">1</span>
									<span class="input-group-text" id="deviseAgenceDisplay-mod-direct">-</span>
									<span class="input-group-text">=</span>
									<input type="number" id="taux-mod-direct" name="taux" class="form-control" placeholder="0.00" step="0.0001" required>
									<span class="input-group-text">CFA</span>
								</div>
							</div>
							<div class="col-md-3">
								<label class="form-label small fw-bold">Total</label>
								<div class="bg-light p-2 rounded text-end">
									<span id="totalAPayer-mod-direct" class="fs-6 fw-bold text-success">0.00 CFA</span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<button id="saveModExchangeDirectBtn" class="btn btn-success">
 
					Enregistrer
				</button>
				<button id="cancelModExchangeDirectBtn" class="btn btn-danger" data-bs-dismiss="modal">
					 
					Annuler
				</button>
			</div>
		</div>
	</div>
</div>

<div class="modal fade" id="modifyExchangeModalClient">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="editCurrencyModalLabel">Modifier Achat/Vente de Devise</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<input type="hidden" name="editClientId" id="editExchangeClientId">
				<input type="hidden" name="editRef" id="editExchangeRef">
				<div class="row g-3">
					<div class="col-md-6">
						<div class="mb-3">
							<label class="form-label fw-bold">Référence</label>
							<input type="text" id="editRef" name="ref" class="form-control shadow-sm" readonly>
						</div>
						<div class="mb-3">
							<label class="form-label fw-bold">Date <span class="text-danger">*</span></label>
							<input type="date" id="editDateOpsEchange" name="date" class="form-control shadow-sm" required>
						</div>
						<div class="mb-3">
							<label class="form-label fw-bold">Type <span class="text-danger">*</span></label>
							<select id="editTypeOpsEchange" name="type" class="form-select form-select-sm" required>
								<option value="achat">Achat</option>
								<option value="vente">Vente</option>
							</select>
						</div>
						<div class="mb-3">
							<label class="form-label fw-bold">Montant <span class="text-danger">*</span></label>
							<div class="input-group input-group-sm">
								<span class="input-group-text">Montant :</span>
								<input type="number" id="editMontantEchange" name="montant" class="form-control" placeholder="0.00" step="0.001" required>
								<span class="input-group-text" id="editDeviseEchange">USD</span>
							</div>
						</div>
					</div>
					<div class="col-md-6">
						<div class="mb-3">
							<label class="form-label fw-bold">Depuis l'agence de : <span class="text-danger">*</span></label>
							<select id="editDestinationEchange" name="destination" class="form-select shadow-sm country-select" required>
								{% for agence in agences %}
									<option value="{{ agence.id }}">
										<small style="font-weight:bold; font-size:8px">{{ agence.abg }}</small>
										<strong>{{ agence.designation }}</strong> - {{ agence.localite }}
									</option>
								{% endfor %}
							</select>
						</div>
						<div class="mb-3">
							<label class="form-label fw-bold">Devise <span class="text-danger">*</span></label>
							<select id="editDeviseExchange" name="deviseExchange" class="form-select shadow-sm country-select" required>
								<option value="USD">USD - Dollar américain</option>
								<option value="AED">AED - Dirham des Émirats Arabes Unis</option>
								<option value="EUR">EUR - Euro</option>
								<option value="GBP">GBP - Livre sterling</option>
								<option value="CNY">CNY - Yuan chinois</option>
								<option value="MAD">MAD - Dirham marocain</option>
								<option value="DZD">DZD - Dinar algérien</option>
							</select>
						</div>
						<div class="mb-3">
							<label class="form-label fw-bold">Taux <span class="text-danger">*</span></label>
							<div class="input-group input-group-sm">
								<span class="input-group-text">1</span>
								<span class="input-group-text" id="editDeviseAgenceDisplayEchange">USD</span>
								<span class="input-group-text">=</span>
								<input type="number" id="editTauxEchange" name="taux" class="form-control" placeholder="0.00" step="0.0001" required>
								<span class="input-group-text">CFA</span>
							</div>
						</div>
					</div>
					<div class="col-12">
						<div class="mb-3">
							<label class="form-label fw-bold">Total</label>
							<div class="bg-light p-2 rounded text-end">
								<span id="editTotalAPayerEchange" class="fw-bold text-success">0.00 CFA</span>
							</div>
						</div>
						<div class="mb-3">
							<label for="editExchangeNote" class="form-label fw-bold">Note (optionnel)</label>
							<textarea class="form-control" id="editExchangeNote" name="note" rows="2"></textarea>
						</div>
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
				<button type="button" class="btn btn-primary" id="editExchangeButton">Enregistrer</button>
			</div>
		</div>
	</div>
</div>

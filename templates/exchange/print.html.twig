{# templates/exchange_receipt.html.twig #}
<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<title>Reçu d'Échange</title>
		<style>
			@page {
				size: A5 landscape;
				margin: 30px;
			}

			body {
				font-family: Arial, sans-serif;
				font-size: 14px;
				margin: 0;
				padding: 0;
			}

			/* En-tête */
			.header {
				display: flex;
				justify-content: space-between;
				align-items: flex-start;
				margin-bottom: 10px;
			}
			.header img {
				width: 128px;
				height: auto;
			}
			.company-info {
				text-align: right;
				font-size: 12px;
			}

			/* Titre centré */
			.title {
				text-align: center;
				font-size: 26px;
				font-weight: bold;
				margin: 10px 0 20px;
				text-transform: uppercase;
			}


			.title small {
				font-size: 14px;
				font-weight: normal;
				font-style: italic;
			}

			/* Cadres */
			.content {
				display: flex;
				gap: 0;
				height: calc(100% - 150px); /* laisser place au header + footer */
			}

			.box {
				flex: 1;
				border: 3px solid black;
				padding: 15px;
				display: flex;
				flex-direction: column;
				justify-content: space-evenly;
				font-size: 18px;
                height: 200px;
			}

			.box span {
				font-weight: bold;
			}

			/* Footer */
			.footer {
				display: flex;
                justify-content: space-between;
				margin-top: 5px;
                margin-left: 20px; 
                margin-right: 20px;
				font-size: 12px;
			}
		</style>
	</head>
	<body>

		<!-- En-tête -->
		<div class="header">
			<div class="logo">
				<img src="{{ asset('assets/img/logo.png') }}" alt="Logo">
			</div>
			<div class="company-info">
				<small>Billeterie-Change-Transaction-Commerce Général</small><br><br>
				BKO IMM. PETIT BAROU<br>
				Tél: (+223) - 66626317 - 76260611<br>
				DUBAI: (+971) - 55 426 2144
			</div>
		</div>

		<!-- Titre -->
		<div class="title">
			REÇU N° {{ exchange.id }}
			<br>
			<small class='text-normal' >{{ "now"|date("d/m/Y H:i") }}</small>
		</div>


		<!-- Contenu principal -->
		<div
			class="content">
			<!-- Cadre gauche -->
			<div class="box">
				<div>Opération :
					<span>{{ exchange.type }} {{ exchange.client ? "client" : ""}} </span>
				</div>
                <div>Date :
                    <span>{{ exchange.date ? exchange.date|date('d/m/Y') : '' }}</span>
                </div> 
				<div>Description :
                    <span>{{ exchange.description }}</span>
                </div> 
			</div>

			<!-- Cadre droit -->
			<div class="box"> 
				<div>Montant CFA :
					<span>{{ exchange.montantCFA | format_currency('CFA', {significant_digits_used:true, min_significant_digits_used:0, max_significant_digits_used:2}, 'fr') }}</span>
				</div>
				<div>Montant Devise :
					<span>{{ exchange.montantDevise | format_currency(exchange.devise, {significant_digits_used:true, min_significant_digits_used:0, max_significant_digits_used:2}, 'fr') }}</span>
				</div> 
				<div>Taux appliqué :
					<span>{{ 1 | format_currency(exchange.devise, {significant_digits_used:true, min_significant_digits_used:0, max_significant_digits_used:2}, 'fr') }} ↔ {{ exchange.taux | format_currency('CFA', {significant_digits_used:true, min_significant_digits_used:0, max_significant_digits_used:2}, 'fr') }}</span>
				</div>
			</div>
		</div>

		<!-- Footer -->
		<div class="footer">
            <span>Signature Client</span>
            <small>Merci pour votre confiance !</small>
			<span>Délivré par : MOUSSA TIGANA</span>
            
		</div>

		<script>
			window.addEventListener('load', function() {
            setTimeout(function() {
                window.print();
                // Fermer après impression si dans un nouvel onglet
                setTimeout(function() { window.close(); }, 500);
            }, 500);
        });
		</script>
	</body>
</html>

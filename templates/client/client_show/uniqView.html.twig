<div class="card card-primary card-outline mb-4">
    <div class="card-header d-flex">
        <h6>Toutes les opérations du client</h6> 
        <div class="col-md-4">
            <input type="text" id="opsFilterDateRange" class="form-control" placeholder="Période (ex. 01/01/2025 - 31/01/2025)">
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="opsTable" class="table">
                <thead>
                    <th>Id</th>
                    <th>Date</th>
                    <th>Opération</th>
                    <th>Description</th>
                    <th>Montant</th>
                    <th>Actions</th>
                </thead>
                <tbody>

                </tbody>
            </table>
        </div>
    </div>
</div>
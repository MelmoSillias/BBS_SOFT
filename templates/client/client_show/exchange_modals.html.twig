<!-- Modal ACHAT ET VENTE de Devise -->
<div class="modal fade" id="currencyModal" tabindex="-1" aria-labelledby="currencyModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="currencyModalLabel">Achat et Vente de Devise</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<input type="hidden" name="clientId" id="exchangeClientId">
				<div class="row g-3">
					<div class="col-md-6">
						<div class="mb-3">
							<label class="form-label fw-bold">Date <span class="text-danger">*</span></label>
							<input type="date" id="dateOpsEchange" name="date" class="form-control shadow-sm" required>
						</div>
						<div class="mb-3">
							<label class="form-label fw-bold">Type <span class="text-danger">*</span></label>
							<select id="typeOpsEchange" name="type" class="form-select form-select-sm" required>
								<option value="achat">Achat</option>
								<option value="vente">Vente</option>
							</select>
						</div>
						<div class="mb-3">
							<label class="form-label fw-bold">Montant <span class="text-danger">*</span></label>
							<div class="input-group input-group-sm">
								<span class="input-group-text">Montant :</span>
								<input type="number" id="montantEchange" name="montant" class="form-control" placeholder="0.00" step="0.001" required>
								<span class="input-group-text" id="deviseEchange">USD</span>
							</div>
						</div>
					</div>
					<div class="col-md-6">
						<div class="mb-3">
							<label class="form-label fw-bold">Depuis l'agence de : <span class="text-danger">*</span></label>
							<select id="destinationEchange" name="destination" class="form-select shadow-sm country-select" required>
								{% for agence in agences %}
									<option value="{{ agence.id }}">
										<small style="font-weight:bold; font-size:8px">{{ agence.abg }}</small>
										<strong>{{ agence.designation }}</strong> - {{ agence.localite }}
									</option>
								{% endfor %}
							</select>
						</div>
						<div class="mb-3">
							<label class="form-label fw-bold">Devise <span class="text-danger">*</span></label>
							<select id="deviseExchange" name="deviseExchange" class="form-select shadow-sm country-select" required>
								<option value="USD">USD - Dollar américain</option>
								<option value="AED">AED - Dirham des Émirats Arabes Unis</option>
								<option value="EUR">EUR - Euro</option>
								<option value="GBP">GBP - Livre sterling</option>
								<option value="CNY">CNY - Yuan chinois</option>
								<option value="MAD">MAD - Dirham marocain</option>
								<option value="DZD">DZD - Dinar algérien</option>
							</select>
						</div>
						<div class="mb-3">
							<label class="form-label fw-bold">Taux <span class="text-danger">*</span></label>
							<div class="input-group input-group-sm">
								<span class="input-group-text">1</span>
								<span class="input-group-text" id="deviseAgenceDisplayEchange">USD</span>
								<span class="input-group-text">=</span>
								<input type="number" id="tauxEchange" name="taux" class="form-control" placeholder="0.00" step="0.000001" required>
								<span class="input-group-text">CFA</span>
							</div>
						</div>
					</div>
					<div class="col-12">
						<div class="mb-3">
							<label class="form-label fw-bold">Total</label>
							<div class="bg-light p-2 rounded text-end">
								<span id="totalAPayerEchange" class="fw-bold text-success">0.00 CFA</span>
							</div>
						</div>
						<div class="mb-3">
							<label for="exchangeNote" class="form-label fw-bold">Note (optionnel)</label>
							<textarea class="form-control" id="exchangeNote" name="note" rows="2"></textarea>
						</div>
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
				<button type="button" class="btn btn-primary" id="exchangeButton">Échanger</button>
			</div>
		</div>
	</div>
</div>


			</div>
		</div>
	</div>
</div>

<!-- Modal DELETE Confirmation -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header bg-danger text-white">
				<h5 class="modal-title" id="deleteConfirmModalLabel">Confirmer la Suppression</h5>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<div class="text-center mb-4">
					<i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 3rem;"></i>
				</div>
				<p class="text-center">Êtes-vous sûr de vouloir supprimer cet échange ?</p>
				<div class="alert alert-warning" role="alert">
					<i class="bi bi-info-circle me-2"></i>
					Cette action est irréversible. Toutes les données associées à cet échange seront définitivement perdues.
				</div>
				<div class="card mt-3">
					<div class="card-body">
						<h6 class="card-title">Détails de l'échange</h6>
						<p class="mb-1">
							<strong>Référence:</strong>
							<span id="delete-reference">EX-002345</span>
						</p>
						<p class="mb-1">
							<strong>Date:</strong>
							<span id="delete-date">26/08/2025</span>
						</p>
						<p class="mb-0">
							<strong>Montant:</strong>
							<span id="delete-amount">200.00 AED</span>
						</p>
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
				<button type="button" class="btn btn-danger" id="confirm-delete-btn">
					<i class="bi bi-trash me-1"></i>
					Supprimer définitivement
				</button>
			</div>
		</div>
	</div>
</div>

<!-- Modal VIEW Details -->
<div class="modal fade" id="viewCurrencyModal" tabindex="-1" aria-labelledby="viewCurrencyModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-lg modal-dialog-centered">
		<div class="modal-content border-0 shadow-lg">
			
			<!-- Header -->
			<div class="modal-header bg-gradient bg-primary text-white">
				<h5 class="modal-title fw-semibold" id="viewCurrencyModalLabel">
					<i class="bi bi-cash-coin me-2"></i>Détails de l'échange de devise
				</h5>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>

			<!-- Body -->
			<div class="modal-body bg-light">
				<input type="hidden" id="viewExchangeClientId">

				<div class="card border-0 shadow-sm">
					<div class="card-body">

						<!-- En-tête -->
						<div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
							<div>
								<h6 class="mb-1 fw-bold text-primary">Référence</h6>
								<span id="viewRef" class="fs-5 text-dark"></span>
							</div>
							<div class="text-end">
								<h6 class="mb-1 fw-bold text-primary">Date</h6>
								<span id="viewDateOpsEchange" class="text-dark"></span>
							</div>
						</div>

						<!-- Informations principales -->
						<div class="row g-4">
							<div class="col-md-6">
								<div class="bg-white rounded-3 shadow-sm p-3 h-100">
									<h6 class="fw-bold text-secondary border-bottom pb-2 mb-3">
										Informations générales
									</h6>
									<p class="mb-2"><strong>Agence :</strong> <span id="viewDestinationEchange" class="ms-1 text-dark"></span></p>
									<p class="mb-2"><strong>Type d'opération :</strong> <span id="viewTypeOpsEchange" class="ms-1 text-dark"></span></p>
									<p class="mb-0"><strong>Devise :</strong> <span id="viewDeviseExchange" class="ms-1 text-dark"></span></p>
								</div>
							</div>

							<div class="col-md-6">
								<div class="bg-white rounded-3 shadow-sm p-3 h-100">
									<h6 class="fw-bold text-secondary border-bottom pb-2 mb-3">
										Montant et Taux
									</h6>
									<p class="mb-2">
										<strong>Montant :</strong>
										<span id="viewMontantEchange" class="ms-1 text-dark"></span>
										<span id="viewDeviseEchange" class="text-muted"></span>
									</p>
									<p class="mb-2">
										<strong>Taux :</strong> 1
										<span id="viewDeviseAgenceDisplayEchange" class="text-muted"></span>
										= <span id="viewTauxEchange" class="text-dark"></span> CFA
									</p>
									<p class="mb-0">
										<strong>Total équivalent :</strong>
										<span id="viewTotalAPayerEchange" class="fw-bold text-success ms-1"></span>
									</p>
								</div>
							</div>
						</div>

						<!-- Note -->
						<div class="mt-4">
							<h6 class="fw-bold text-secondary border-bottom pb-2 mb-2">Note</h6>
							<div class="bg-white p-3 rounded-3 shadow-sm">
								<p id="viewExchangeNote" class="mb-0 text-dark" style="white-space: pre-line;"></p>
							</div>
						</div>

					</div>
				</div>
			</div>

			<!-- Footer -->
			<div class="modal-footer bg-white">
				<button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">
					<i class="bi bi-x-lg me-1"></i> Fermer
				</button>
			</div>

		</div>
	</div>
</div>

{# templates/transfert/print.html.twig #}
<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<title>Reçu de transfert</title>
		<style>
			@page { size: A5 landscape; margin: 30px; }
			body { font-family: Arial, sans-serif; font-size: 14px; margin: 0; padding: 0; }
			.header { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:10px; }
			.header img { width:116px; height:auto; }
			.company-info { text-align:right; font-size:12px; }
			.title { text-align:center; font-size:20px; font-weight:bold; margin:10px 0 20px; text-transform:uppercase; }
			.content { display:flex; gap:0; height:calc(100% - 150px); }
			.box { flex:1; border:3px solid black; padding:15px; display:flex; flex-direction:column; justify-content:space-evenly; font-size:18px; height:180px; }
			.box div { border-bottom:1px dashed black; }
			.box span { font-weight:bold; }
			.footer { display:flex; justify-content:space-between; margin-top:0; margin-left:20px; margin-right:20px; font-size:12px; }
		</style>
	</head>
	<body>

	{% import '_macros/amounts.html.twig' as amt %}

		<!-- En-tête -->
		<div class="header">
			<div class="logo"><img src="{{ asset('assets/img/logo.png') }}" alt="Logo"></div>
			<div class="company-info">
				<small>Billeterie-Change-Transaction-Commerce Général</small><br><br>
				BKO IMM. PETIT BAROU<br>
				Tél: (+223) - 66626317 - 76260611<br>
				DUBAI: (+971) - 55 426 2144
			</div>
		</div>

		<hr>
		<div class="title">REÇU N° {{ transfert.ref }}<br><small class='text-normal'>{{ "now"|date('d/m/Y H:i') }}</small></div>

		<div class="content">
			<div class="box">
				<div>Opération : <span>{{ transfert.type == 'standard' ? 'Envoi Cash' : 'Retrait sur compte' }}</span></div>
				<div>Date : <span>{{ transfert.createdAt ? transfert.createdAt|date('d/m/Y') : '' }}</span></div>
				<div>Nom Client :
					{% set expediteurName = transfert.senderActualName ?: (transfert.client ? transfert.client.nomComplet : transfert.senderName) %}
					<span>{{ expediteurName }}</span>
				</div>
				<div>Destinataire : <span>{{ transfert.receiverName }}</span></div>
				<div>Destination : <span>{{ transfert.agence.abg }}</span></div>
			</div>

			<div class="box"> 
				<div>Montant Dollars : <span>{{ amt.format_amount(transfert.montantUSD, 2) }} USD</span></div>
				<div>Montant Reception : <span>{{ amt.format_amount(transfert.montantReception|round(0, 'common'), 0) }} {{ transfert.agence.deviseLocal }}</span></div>
				<div>Taux : <span>{{ amt.format_amount(transfert.taux, 6) }}</span></div>
				<div>Frais : <span>{{ amt.format_amount(transfert.frais) }} F CFA</span></div>
				<div>Montant Total Rémis : <span>{{ amt.format_amount((transfert.montantCFA + transfert.frais)) }} F CFA</span></div>
			</div>
		</div>

		<div class="footer">
			<span>Signature Client</span>
			<small>Merci pour votre confiance !</small>
			<span>Délivré par : MOUSSA TIGANA</span>
		</div>

		<script>
			window.addEventListener('load', function(){ setTimeout(function(){ window.print(); setTimeout(function(){ window.close(); },500); },500); });
		</script>
	</body>
</html>

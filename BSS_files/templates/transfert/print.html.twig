{# templates/transfert_receipt.html.twig #}
<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<title>Reçu d'Échange</title>
		<style>
			@page {
				size: A5 landscape;
				margin: 30px;
			}

			body {
				font-family: Arial, sans-serif;
				font-size: 14px;
				margin: 0;
				padding: 0;
				page-break: none
			}

			/* En-tête */
			.header {
				display: flex;
				justify-content: space-between;
				align-items: flex-start;
				margin-bottom: 10px;
			}
			.header img {
				width: 116px;
				height: auto;
			}
			.company-info {
				text-align: right;
				font-size: 12px;
			}

			/* Titre centré */
			.title {
				text-align: center;
				font-size: 20px;
				font-weight: bold;
				margin: 10px 0 20px;
				text-transform: uppercase;
			}

			.title small {
				font-size: 12px;
				font-weight: normal;
				font-style: italic;
			}

			/* Cadres */
			.content {
				display: flex;
				gap: 0;
				height: calc(100% - 150px); /* laisser place au header + footer */
			}

			.box {
				flex: 1;
				border: 3px solid black;
				padding: 15px;
				display: flex;
				flex-direction: column;
				justify-content: space-evenly;
				font-size: 18px;
                height: 180px;
			}

			.box div {
				border-bottom: 1px dashed black;
			}

			.box span {
				font-weight: bold;
			}

			/* Footer */
			.footer {
				display: flex;
                justify-content: space-between;
				margin-top: 0px;
                margin-left: 20px; 
                margin-right: 20px;
				font-size: 12px;
			}
		</style>
	</head>
	<body>

		<!-- En-tête -->
		<div class="header">
			<div class="logo">
				<img src="{{ asset('assets/img/logo.png') }}" alt="Logo">
			</div>
			<div class="company-info">
				<small>Billeterie-Change-Transaction-Commerce Général</small><br><br>
				BKO IMM. PETIT BAROU<br>
				Tél: (+223) - 66626317 - 76260611<br>
				DUBAI: (+971) - 55 426 2144
			</div>
		</div>

        <hr>
		<!-- Titre -->
		<div class="title">
			REÇU N° {{ transfert.ref }}
			<br>
			<small class='text-normal' >{{ "now"|date("d/m/Y H:i") }}</small>
		</div>


		<!-- Contenu principal -->
		<div
			class="content">
			<!-- Cadre gauche -->
			<div class="box">
				<div>Opération :
					<span>{{ transfert.type == "standard" ? "Envoi Cash" : "Retrait sur compte" }}</span>
				</div>
                <div>Date :
                    <span>{{ transfert.createdAt ? transfert.createdAt|date('d/m/Y') : '' }}</span>
                </div>
				<div>Nom Client :
					<span>{{ transfert.client ? transfert.client.nomComplet }} {{" | "}} {{ transfert.client ? transfert.client.phoneNumber : transfert.senderName }}+ {{' | '  }} {{transfert.senderPhone  }}</span>
				</div> 
				<div>Destinataire :
					<span>{{ transfert.receiverName }} {{" | "}} {{ transfert.receiverPhone }}</span>
				</div>
                <div>Destination :
					<span>{{ transfert.agence.abg }}  </span>
				</div>
			</div>
<div class="box">
			<!-- Cadre droit
			
				 
                <div>Montant CFA :
					<span>{{ transfert.montantCFA | format_currency('CFA', {significant_digits_used:true, min_significant_digits_used:0, max_significant_digits_used:20}, 'fr') }}</span> 
                </div> -->
                <div>Montant Dollars :
                    <span>{{ transfert.montantUSD | format_currency('USD', {significant_digits_used:true, min_significant_digits_used:0, max_significant_digits_used:20}, 'fr') }}</span> 
                </div>
                <div>Montant Reception :
					<span>
  {{ transfert.montantReception|format_currency(
       transfert.agence.deviseLocal,
       {
         rounding_mode: 'halfup',
         min_fraction_digit: 0,
         max_fraction_digit: 0
       },
       'fr'
  ) }}
</span>

                
                </div>
				 
				<div>Taux : {{ transfert.taux | format_currency('CFA', {significant_digits_used:true, min_significant_digits_used:0, max_significant_digits_used:20}, 'fr') }}</span>
				</div>

                <div>Frais :
					<span>{{ transfert.frais | format_currency('CFA', {significant_digits_used:true, min_significant_digits_used:0, max_significant_digits_used:20}, 'fr') }}</span>
				</div>

                <div>Montant Total Rémis :
					<span>{{ (transfert.montantCFA + transfert.frais) | format_currency('CFA', {significant_digits_used:true, min_significant_digits_used:0, max_significant_digits_used:20}, 'fr')}}</span>
				</div>
			</div>
		</div>

		<!-- Footer -->
		<div class="footer">
            <span>Signature Client</span>
            <small>Merci pour votre confiance !</small>
			<span>Délivré par : MOUSSA TIGANA</span>
            
		</div>

		<script>
			window.addEventListener('load', function() {
            setTimeout(function() {
                window.print();
                // Fermer après impression si dans un nouvel onglet
                setTimeout(function() { window.close(); }, 500);
            }, 500);
        });
		</script>
	</body>
</html>
